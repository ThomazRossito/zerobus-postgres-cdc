# Copie para .env e preencha. O .env está no .gitignore: nunca commitar.

# ---- PostgreSQL local (MacBook) ----
PG_HOST=localhost
PG_PORT=5432
PG_DBNAME=retail_demo
# usuário de replicação (criado em postgres/01_replication.sql) usado pelo Debezium
PG_USER=dbz
PG_PASSWORD=dbz_local_2026
# usuário administrativo usado pelo gerador (seed e simulador)
PG_USER_ADMIN=postgres
PG_PASSWORD_ADMIN=

# ---- Databricks (testado no Free Edition, AWS us-east-2) ----
# URL do workspace, sem barra no fim. Ex.: https://dbc-a1b2c3d4-e5f6.cloud.databricks.com
DATABRICKS_WORKSPACE_URL=
# Endpoint Zerobus: <workspace-id>.zerobus.<regiao>.cloud.databricks.com (AWS)
#                   <workspace-id>.zerobus.<regiao>.azuredatabricks.net   (Azure)
# workspace-id = número depois de ?o= na URL (no Azure, depois de adb-). regiao: SELECT current_metastore()
ZEROBUS_SERVER_ENDPOINT=
# Service principal com entitlement "Workspace access" e grants na tabela (databricks/02_grants.sql)
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
# Catálogo do Unity Catalog. Vira o topic.prefix do Debezium: retail.orders -> <UC_CATALOG>.retail.orders
UC_CATALOG=

# ---- Medição de latência (measure/latency.py) ----
# perfil da Databricks CLI (databricks auth login) ou deixe vazio e use DATABRICKS_HOST/DATABRICKS_TOKEN
DATABRICKS_CONFIG_PROFILE=
WAREHOUSE_ID=
